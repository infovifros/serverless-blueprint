{
  "name": "serverless-blueprint",
  "version": "1.0.0",
  "description": "Production-ready AWS Serverless starter — in-memory CRUD, schema validation, Swagger, and a Claude Code slash command to scaffold new endpoints.",
  "private": true,
  "scripts": {
    "start": "sls offline --noPrependStageInUrl --stage=local start",
    "start:dev": "sls offline --noPrependStageInUrl --stage=dev start",
    "deploy:dev": "sls deploy --stage=dev",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=false eslint 'src/**/*.{ts,tsx}' --fix",
    "schema": "bash scripts/schema-generator.sh",
    "swagger": "node scripts/generate-swagger.js",
    "postinstall": "bash scripts/schema-generator.sh && node scripts/generate-swagger.js"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.750.0",
    "@vifros/aws-serverless-core": "^1.0.0",
    "http-status-codes": "^2.3.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.122",
    "@types/node": "^18.19.76",
    "@types/uuid": "^9.0.4",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.4",
    "serverless": "3.40.0",
    "serverless-offline": "^13.9.0",
    "serverless-plugin-typescript": "^2.1.5",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2",
    "typescript-json-schema": "^0.61.0",
    "yamljs": "^0.3.0"
  },
  "overrides": {
    "tar": "^7.5.7",
    "rimraf": "^5.0.10",
    "minimatch": ">=9.0.7"
  },
  "contributors": [
    {
      "name": "Jose Carlos Ramos",
      "email": "jramoscarmenates@gmail.com"
    }
  ],
  "license": "MIT",
  "keywords": [
    "serverless",
    "blueprint",
    "boilerplate",
    "typescript",
    "aws",
    "aws-lambda",
    "api-gateway"
  ],
  "engines": {
    "npm": ">=9.1.2",
    "node": ">=22"
  }
}
